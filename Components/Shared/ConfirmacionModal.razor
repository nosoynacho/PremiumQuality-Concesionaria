@if (Visible)
{
    <div class="modal-confirmacion-fondo">

        <section class="modal-confirmacion"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="titulo-confirmacion">

            <header>
                <h3 id="titulo-confirmacion">
                    @Titulo
                </h3>
            </header>

            <p>@Mensaje</p>

            <footer class="acciones-modal">

                <button type="button"
                        class="btn btn-secondary"
                        @onclick="Cancelar">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-danger"
                        @onclick="Confirmar">
                    Eliminar
                </button>

            </footer>

        </section>

    </div>
}

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public string Titulo { get; set; }
        = "Confirmación";

    [Parameter]
    public string Mensaje { get; set; }
        = "¿Está seguro?";

    [Parameter]
    public EventCallback OnConfirmar { get; set; }

    [Parameter]
    public EventCallback OnCancelar { get; set; }

    private Task Confirmar()
    {
        return OnConfirmar.InvokeAsync();
    }

    private Task Cancelar()
    {
        return OnCancelar.InvokeAsync();
    }
}