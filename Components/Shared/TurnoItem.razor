@using blazornacho.Models

<article class="turno-item turno-card">

    <b>@Turno.Nombre</b>

    <br />

    Fecha:
    @Turno.Fecha.ToString("dd/MM/yyyy")

    <br />

    Hora:
    @Turno.Hora

    <br />

    Motivo:
    @Turno.Motivo

    <br />

    <small>
        Reservado el
        @Turno.FechaReserva.ToString("dd/MM/yyyy HH:mm")
    </small>

    <div class="mt-3">

        <button type="button"
                class="btn btn-primary me-2"
                @onclick="Editar">
            Editar
        </button>

        <button type="button"
                class="btn btn-danger"
                @onclick="Eliminar">
            Eliminar
        </button>

    </div>

</article>

@code {
    [Parameter, EditorRequired]
    public Turno Turno { get; set; } = default!;

    [Parameter]
    public EventCallback<long> OnEditar { get; set; }

    [Parameter]
    public EventCallback<long> OnEliminar { get; set; }

    private Task Editar()
    {
        return OnEditar.InvokeAsync(Turno.Id);
    }

    private Task Eliminar()
    {
        return OnEliminar.InvokeAsync(Turno.Id);
    }
}