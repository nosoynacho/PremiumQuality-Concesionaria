@page "/registrarse"

<PageTitle>
    Registrarse - Premium Quality
</PageTitle>

<section class="auth-page">

    <div class="auth-card auth-card--wide">

        <header class="auth-card__header">

            <h2>
                Crear una cuenta
            </h2>

            <p>
                Registrate para acceder a
                Seguros, Reseñas y Turnos.
            </p>

        </header>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="auth-alert auth-alert--error">
                @Error
            </div>
        }

        <form method="post"
              action="/auth/registro"
              class="auth-form"
              novalidate>

            <AntiforgeryToken />

            <div class="auth-grid">

                <div class="auth-field">

                    <label>
                        Nombre
                    </label>

                    <input name="Nombre"
                           type="text"
                           minlength="2"
                           maxlength="60"
                           autocomplete="given-name"
                           required />

                </div>

                <div class="auth-field">

                    <label>
                        Apellido
                    </label>

                    <input name="Apellido"
                           type="text"
                           minlength="2"
                           maxlength="60"
                           autocomplete="family-name"
                           required />

                </div>

            </div>

            <div class="auth-field">

                <label>
                    Correo electrónico
                </label>

                <input name="Correo"
                       type="email"
                       maxlength="150"
                       autocomplete="email"
                       required
                       placeholder="nombre@correo.com" />

            </div>

            <div class="auth-grid">

                <div class="auth-field">

                    <label>
                        Contraseña
                    </label>

                    <input name="Password"
                           type="password"
                           minlength="8"
                           maxlength="100"
                           autocomplete="new-password"
                           required />

                    <small>
                        Mínimo 8 caracteres,
                        con mayúscula,
                        minúscula y número.
                    </small>

                </div>

                <div class="auth-field">

                    <label>
                        Repetir contraseña
                    </label>

                    <input name="ConfirmarPassword"
                           type="password"
                           minlength="8"
                           maxlength="100"
                           autocomplete="new-password"
                           required />

                </div>

            </div>

            <div class="auth-field">

                <label>
                    PIN de recuperación
                </label>

                <input name="CodigoRecuperacion"
                       type="password"
                       inputmode="numeric"
                       pattern="[0-9]{6}"
                       minlength="6"
                       maxlength="6"
                       required
                       placeholder="6 números" />

                <small>
                    Guardá este PIN.
                    Solamente lo necesitarás
                    si olvidás tu contraseña.
                </small>

            </div>

            <button type="submit"
                    class="auth-primary-button">

                Crear cuenta

            </button>

        </form>

        <nav class="auth-links">

            <span>
                ¿Ya tenés una cuenta?

                <a href="/iniciar-sesion">
                    Iniciar sesión
                </a>
            </span>

        </nav>

    </div>

</section>

@code
{
    [SupplyParameterFromQuery(
        Name = "error"
    )]
    public string? Error { get; set; }
}