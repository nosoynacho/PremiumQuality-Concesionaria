@page "/recuperar-password"

<PageTitle>
    Recuperar contraseña - Premium Quality
</PageTitle>

<section class="auth-page">

    <div class="auth-card">

        <header class="auth-card__header">

            <h2>
                Recuperar contraseña
            </h2>

            <p>
                Usá el correo de tu cuenta
                y el PIN que elegiste al
                registrarte.
            </p>

        </header>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="auth-alert auth-alert--error">
                @Error
            </div>
        }

        <form method="post"
              action="/auth/recuperar-password"
              class="auth-form">

            <AntiforgeryToken />

            <div class="auth-field">

                <label>
                    Correo electrónico
                </label>

                <input name="Correo"
                       type="email"
                       required />

            </div>

            <div class="auth-field">

                <label>
                    PIN de recuperación
                </label>

                <input name="CodigoRecuperacion"
                       type="password"
                       inputmode="numeric"
                       pattern="[0-9]{6}"
                       minlength="6"
                       maxlength="6"
                       required />

            </div>

            <div class="auth-field">

                <label>
                    Nueva contraseña
                </label>

                <input name="NuevaPassword"
                       type="password"
                       minlength="8"
                       maxlength="100"
                       required />

                <small>
                    Debe contener al menos
                    una mayúscula,
                    una minúscula y un número.
                </small>

            </div>

            <div class="auth-field">

                <label>
                    Repetir nueva contraseña
                </label>

                <input name="ConfirmarPassword"
                       type="password"
                       minlength="8"
                       maxlength="100"
                       required />

            </div>

            <button type="submit"
                    class="auth-primary-button">

                Cambiar contraseña

            </button>

        </form>

        <nav class="auth-links">

            <a href="/iniciar-sesion">
                Volver a iniciar sesión
            </a>

        </nav>

    </div>

</section>

@code
{
    [SupplyParameterFromQuery(
        Name = "error"
    )]
    public string? Error { get; set; }
}